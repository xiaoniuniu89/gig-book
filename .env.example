# Copy to .env.local for local development. Never commit real values.

# Spotify (server only). Client Credentials flow for search and track lookups.
SPOTIFY_CLIENT_ID=84afdb072a6a4e7e80b9bf4d704b5eb2
SPOTIFY_CLIENT_SECRET=

# Supabase. Leave both empty to keep everything in this browser (IndexedDB).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public press kit pages (/epk/<slug>) sign promo-file links on the server (server only, never NEXT_PUBLIC_). Without it, public files are left out.
SUPABASE_SERVICE_ROLE_KEY=

# AI setlist drafts via OpenRouter (server only, never NEXT_PUBLIC_). Leave the key empty to turn the feature off.
OPENROUTER_API_KEY=
# Optional model id; default anthropic/claude-haiku-5.5
AI_MODEL=
