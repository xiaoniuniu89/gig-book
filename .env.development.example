# Copy to .env.development.local. `npm run dev` then uses the dev project, not live
# (Next.js reads this file over .env.local in development only; builds and Vercel still use live).
NEXT_PUBLIC_SUPABASE_URL=https://<dev-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# For npm run seed:dev (fake musicians) and npm run db:dev (migrations, uses your `npx supabase login`). Never share these.
DEV_SUPABASE_REF=<dev-ref>
SUPABASE_SERVICE_ROLE_KEY=
